APP_NAME="Manager Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Required
DATABASE_URL=postgresql://library:library@db:5432/library
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:5173

# Optional
COVERS_DIR=./var/covers

# Sessions and cache never use the database
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
